# ⚠️ 请填入 DeepSeek API 密钥（在 https://platform.deepseek.com 获取）
# 课程演示期间可用开发者自己的 key；本文件请勿上传公开仓库
DEEPSEEK_API_KEY=sk-在此填入你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

POSTGRES_DSN=postgresql://postgres:postgres@localhost:5433/studymind
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
CHROMA_PATH=./kb

# 嵌入模型：随包附带（backend/models/bge-m3，离线可用）
BGE_M3_PATH=./models/bge-m3
# 模型缺失需联网下载时走国内镜像
HF_ENDPOINT=https://hf-mirror.com
